# Ignore large data files
*.mp4
*.pt
*.pth
*.npy

# Ignore dataset folders
dataset/
authors_model_inspection/
processed_data/
processed_data_bo_conf/
processed_data_for_evaluation/
WU-SAHZU-EMU-Video/
LOPO/

# Ignore Python cache
__pycache__/
*.pyc
.DS_Store
.vscode/

# Ignore documentation files
docs/
# Generated outputs (checkpoints, logs, reports)
outputs/**/*.pth
outputs/**/*.json
# ...except the small per-run records. A training curve costs hours to regenerate
# and is a few KB to keep; it should never again exist only on one disk.
!outputs/**/training_log.json
!outputs/**/run_manifest.json
!outputs/**/per_fold.json
!outputs/**/pooled.json
outputs/**/*.csv
outputs/**/*.png
!outputs/*.pdf

# Processed data tensors
processed_data/patches/
processed_data/kpts/

# Leftover temp files from evaluation
temp_eval.json
temp_fdr.json

# Audit scratch (extracted paper text) and generated env lock
_audit_tmp/
environment_lock.txt
environment_lock.yml
